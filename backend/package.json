{
  "name": "@destrabe/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy --schema=prisma/schema.prisma && node dist/server.js",
    "test": "vitest run",
    "flags:check": "tsx src/scripts/checkFeatureFlags.ts"
  },
  "dependencies": {
    "@destrabe/shared": "*",
    "@prisma/client": "^5.22.0",
    "better-auth": "^1.7.27",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mercadopago": "~3.6.2",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prisma": "^5.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=26 <27"
  }
}
