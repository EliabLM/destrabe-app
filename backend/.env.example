# Plantilla de producción: NO usar estos placeholders como credenciales reales.
NODE_ENV=production
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/DB_NAME"
REDIS_URL="redis://REDIS_HOST:6379"
BETTER_AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"
BETTER_AUTH_URL="https://YOUR_API_HOST"
CORS_ORIGIN="https://YOUR_APP_ORIGIN"
PAYMENT_GATEWAY=stub
PAYMENT_WEBHOOK_TOKEN="REPLACE_WITH_RANDOM_WEBHOOK_TOKEN"
# Opcionales: completar los tres valores para enviar SMS con Plivo.
# En producción, sin credenciales el envío de OTP FALLA (no se imprime el código).
# Fuera de producción, sin credenciales, el OTP se imprime en el log con el
# teléfono enmascarado. No enviar SMS reales desde esta plantilla.
# PLIVO_AUTH_ID="YOUR_PLIVO_AUTH_ID"
# PLIVO_AUTH_TOKEN="YOUR_PLIVO_AUTH_TOKEN"
# PLIVO_PHONE_NUMBER="YOUR_PLIVO_SENDER"
# SERVICE_TIMEOUT_MINUTES=15
# NEARBY_RADIUS_KM=5
# Proxies de confianza (Express `trust proxy`): IP/CIDR separados por comas o
# alias loopback/linklocal/uniquelocal. Debe cubrir la red Docker de Traefik.
# TRUST_PROXY=loopback,uniquelocal
# Límites del OTP por SMS (persistidos en Postgres; ventanas deslizantes).
# Solo se aceptan móviles colombianos (+573XXXXXXXXX).
# SMS_LIMIT_PHONE_15MIN=3
# SMS_LIMIT_PHONE_DAY=10
# SMS_LIMIT_IP_HOUR=10
# SMS_LIMIT_IP_DAY=30
# Tope global de SMS en 24 h (coste Plivo: hasta ~USD 0,38 por SMS en algunas rutas).
# SMS_DAILY_CAP=50
# OTP_TEST_NUMBERS / OTP_TEST_CODE: SOLO desarrollo y pruebas. Definirlos en
# producción hace fallar el arranque.
