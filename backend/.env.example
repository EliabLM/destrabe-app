# Base de datos (dev via docker-compose.dev.yml)
POSTGRES_DB=destrabe_db
POSTGRES_USER=destrabe
POSTGRES_PASSWORD=destrabe
DATABASE_URL="postgresql://destrabe:destrabe@localhost:5432/destrabe_db"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (Better Auth + Plivo)
BETTER_AUTH_SECRET="<min-32-chars-random-secret>"
BETTER_AUTH_URL="http://localhost:3000"
# PLIVO_AUTH_ID=""    # opcional: ID de autenticación Plivo
# PLIVO_AUTH_TOKEN=""  # opcional: token de autenticación Plivo
# PLIVO_PHONE_NUMBER="" # opcional: número origen SMS Plivo (ej. +1234567890)

# Service lifecycle
SERVICE_TIMEOUT_MINUTES=15
NEARBY_RADIUS_KM=5

# App
NODE_ENV=development
PORT=3000
