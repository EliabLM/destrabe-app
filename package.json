{
  "name": "destrabe-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts --passWithNoTests",
    "test:all": "npm test && npm run test:db",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d postgres redis",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.0"
  }
}
