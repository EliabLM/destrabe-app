{
  "expo": {
    "name": "destrabe",
    "slug": "destrabe",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "destrabe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.destrabe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.destrabe.app"
    },
    "plugins": [
      "@rnmapbox/maps",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a1a2e"
        }
      ]
    ]
  }
}
